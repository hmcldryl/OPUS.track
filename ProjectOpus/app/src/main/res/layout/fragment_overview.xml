                </RelativeLayout>
            </LinearLayout>-->

            <LinearLayout
                android:id="@+id/latestToday2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/latestToday"
                android:orientation="horizontal">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/colorPrimaryDark"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/globe"
                        android:layout_width="80dp"
                        android:layout_height="70dp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_globe" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@+id/globe"
                        android:paddingStart="0dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="5dp"
                        android:paddingBottom="5dp">

                        <TextView
                            android:id="@+id/today1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="2dp"
                            android:fontFamily="@font/montserrat_bold"
                            android:text="World Today"
                            android:textAlignment="textStart"
                            android:textColor="@color/colorPrimary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/updatedAsOf1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:layout_toEndOf="@+id/today1"
                            android:fontFamily="@font/montserrat"
                            android:text="(EEE, MMMM dd)"
                            android:textAlignment="textStart"
                            android:textColor="@color/colorPrimary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/today_populationGlobal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/today1"
                            android:fontFamily="@font/montserrat"
                            android:text="Population:"
                            android:textAlignment="textStart"
                            android:textColor="@color/colorPrimary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/today_recoveredGlobal"
                            android:layout_width="145dp"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/today_populationGlobal"
                            android:fontFamily="@font/montserrat"
                            android:text="Recovered: 0"
                            android:textAlignment="textStart"
                            android:textColor="@color/colorPrimary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/today_confirmedGlobal"
                            android:layout_width="145dp"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/today_recoveredGlobal"
                            android:fontFamily="@font/montserrat"
                            android:text="Confirmed: 0"
                            android:textAlignment="textStart"
                            android:textColor="@color/colorPrimary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/today_deathsGlobal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/today_recoveredGlobal"
                            android:layout_toEndOf="@+id/today_confirmedGlobal"
                            android:fontFamily="@font/montserrat"
                            android:text="Deaths: 0"
                            android:textAlignment="textStart"
                            android:textColor="@color/colorPrimary"
                            android:textSize="12sp" />
                    </RelativeLayout>
                </RelativeLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_below="@id/latestToday2"
                android:background="@color/colorPrimaryDark"
                android:padding="10dp">


            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
</ScrollView>