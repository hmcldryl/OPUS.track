<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#543864"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <ImageView
            android:id="@+id/timeline_updated_on_text"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginStart="2dp"
            android:layout_marginBottom="2dp"
            android:layout_marginEnd="2dp"
            android:fontFamily="sans-serif-medium"
            android:src="@drawable/ic_time"
            android:textColor="@color/colorAccent" />
        <TextView
            android:id="@+id/timeline_updated_on"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/timeline_updated_on_text"
            android:fontFamily="sans-serif-medium"
            android:text=""
            android:textColor="@color/colorPrimaryDark"
            android:textSize="12sp"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/timeline_updated_on_text"
            android:background="@color/colorPrimary"
            android:paddingStart="5dp"
            android:paddingEnd="5dp">

            <TextView
                android:id="@+id/timeline_deaths"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Deaths:"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/timeline_deaths_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/timeline_deaths"
                android:fontFamily="sans-serif-light"
                android:text="No reported cases."
                android:textColor="@color/colorPrimaryDark"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/timeline_confirmed"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:layout_below="@id/timeline_deaths"
                android:fontFamily="sans-serif-medium"
                android:text="Confirmed:"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/timeline_confirmed_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/timeline_deaths_text"
                android:layout_toEndOf="@id/timeline_confirmed"
                android:fontFamily="sans-serif-light"
                android:text="No reported cases."
                android:textColor="@color/colorPrimaryDark"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/timeline_recovered"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:layout_below="@id/timeline_confirmed"
                android:fontFamily="sans-serif-medium"
                android:text="Recovered: "
                android:textColor="@color/colorPrimaryDark"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/timeline_recovered_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/timeline_confirmed_text"
                android:layout_toEndOf="@id/timeline_recovered"
                android:fontFamily="sans-serif-light"
                android:text="No reported cases."
                android:textColor="@color/colorPrimaryDark"
                android:textSize="12sp" />
        </RelativeLayout>
    </RelativeLayout>

</RelativeLayout>