<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary"
    tools:context=".ui.home.OverviewFragment">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/latestToday"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="5dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/colorPrimaryDark"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:id="@+id/ph2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_below="@+id/ph1"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp"
                        android:layout_marginBottom="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/phData1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="2dp"
                            android:fontFamily="@font/montserrat_bold"
                            android:text="Philippine All-Time Data"
                            android:textAlignment="center"
                            android:textColor="@color/colorPrimary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/phData"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="2dp"
                            android:fontFamily="@font/montserrat_bold"
                            android:text=""
                            android:textAlignment="textStart"
                            android:textColor="@color/colorPrimary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/phTotalCases"
                            android:layout_width="140dp"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/phData"
                            android:fontFamily="@font/montserrat"
                            android:text="Cases: -n/a-"
                            android:textAlignment="textStart"
                            android:textColor="@color/colorPrimary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/phTotalRecoveries"
                            android:layout_width="140dp"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/phTotalCases"
                            android:fontFamily="@font/montserrat"
                            android:text="Recoveries: -n/a-"
                            android:textAlignment="textStart"
                            android:textColor="@color/colorPrimary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/phTotalAdmitted"
                            android:layout_width="140dp"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/phTotalRecoveries"
                            android:fontFamily="@font/montserrat"
                            android:text="Admitted: -n/a-"
                            android:textAlignment="textStart"
                            android:textColor="@color/colorPrimary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/phTotalRecovery"
                            android:layout_width="140dp"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/phData"
                            android:layout_toEndOf="@+id/phTotalCases"
                            android:fontFamily="@font/montserrat"
                            android:text="Recovery Rate: -n/a-"
                            android:textAlignment="textStart"
                            android:textColor="@color/colorPrimary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/phFatality"
                            android:layout_width="140dp"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/phTotalRecovery"
                            android:layout_toEndOf="@+id/phTotalRecoveries"
                            android:fontFamily="@font/montserrat"
                            android:text="Fatality Rate: -n/a-"
                            android:textAlignment="textStart"
                            android:textColor="@color/colorPrimary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/phTotalDeaths"
                            android:layout_width="140dp"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/phFatality"
                            android:layout_toEndOf="@+id/phTotalAdmitted"
                            android:fontFamily="@font/montserrat"
                            android:text="Deaths: -n/a-"
                            android:textAlignment="textStart"
                            android:textColor="@color/colorPrimary"
                            android:textSize="12sp" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/ph1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/phFlag"
                            android:layout_width="80dp"
                            android:layout_height="70dp"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_philippines" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@+id/phFlag"
                            android:paddingStart="0dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="5dp">

                            <TextView
                                android:id="@+id/today"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="2dp"
                                android:fontFamily="@font/montserrat_bold"
                                android:text="Philippines"
                                android:textAlignment="textStart"
                                android:textColor="@color/colorPrimary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/updatedAsOf"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:layout_toEndOf="@+id/today"
                                android:fontFamily="@font/montserrat"
                                android:text="(EEE, MMMM dd)"
                                android:textAlignment="textStart"
                                android:textColor="@color/colorPrimary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/today_pop"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/today"
                                android:fontFamily="@font/montserrat"
                                android:text="Population: -n/a-"
                                android:textAlignment="textStart"
                                android:textColor="@color/colorPrimary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/today_cases"
                                android:layout_width="125dp"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/today_pop"
                                android:fontFamily="@font/montserrat"
                                android:text="Cases: -n/a-"
                                android:textAlignment="textStart"
                                android:textColor="@color/colorPrimary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/today_admitted"
                                android:layout_width="125dp"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/today_cases"
                                android:fontFamily="@font/montserrat"
                                android:text="Admitted: -n/a-"
                                android:textAlignment="textStart"
                                android:textColor="@color/colorPrimary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/today_deaths"
                                android:layout_width="125dp"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/today_recovered"
                                android:layout_toEndOf="@+id/today_admitted"
                                android:fontFamily="@font/montserrat"
                                android:text="Deaths: -n/a-"
                                android:textAlignment="textStart"
                                android:textColor="@color/colorPrimary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/today_recovered"
                                android:layout_width="125dp"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/today_pop"
                                android:layout_toEndOf="@id/today_cases"
                                android:fontFamily="@font/montserrat"
                                android:text="Recoveries: -n/a-"
                                android:textAlignment="textStart"
                                android:textColor="@color/colorPrimary"
                                android:textSize="12sp" />
                        </RelativeLayout>
                    </RelativeLayout>
                </RelativeLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/latestToday2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/latestToday"
                android:orientation="horizontal">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/colorPrimaryDark"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/globe"
                        android:layout_width="80dp"
                        android:layout_height="70dp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_globe" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@+id/globe"
                        android:paddingStart="0dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="5dp"
                        android:paddingBottom="5dp">

                        <TextView
                            android:id="@+id/today1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="2dp"
                            android:fontFamily="@font/montserrat_bold"
                            android:text="Worldwide"
                            android:textAlignment="textStart"
                            android:textColor="@color/colorPrimary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/updatedAsOf1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:layout_toEndOf="@+id/today1"
                            android:fontFamily="@font/montserrat"
                            android:text="(EEE, MMM dd, HH:ss)"
                            android:textAlignment="textStart"
                            android:textColor="@color/colorPrimary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/today_populationGlobal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/today1"
                            android:fontFamily="@font/montserrat"
                            android:text="Population: -n/a-"
                            android:textAlignment="textStart"
                            android:textColor="@color/colorPrimary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/today_recoveredGlobal"
                            android:layout_width="145dp"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/today_casesGlobal"
                            android:fontFamily="@font/montserrat"
                            android:text="Recovered: -n/a-"
                            android:textAlignment="textStart"
                            android:textColor="@color/colorPrimary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/today_casesGlobal"
                            android:layout_width="145dp"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/today_populationGlobal"
                            android:fontFamily="@font/montserrat"
                            android:text="Cases: -n/a-"
                            android:textAlignment="textStart"
                            android:textColor="@color/colorPrimary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/today_deathsGlobal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/today_casesGlobal"
                            android:layout_toEndOf="@+id/today_recoveredGlobal"
                            android:fontFamily="@font/montserrat"
                            android:text="Deaths: -n/a-"
                            android:textAlignment="textStart"
                            android:textColor="@color/colorPrimary"
                            android:textSize="12sp" />
                    </RelativeLayout>
                </RelativeLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/overviewText1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/latestToday2"
                android:fontFamily="@font/montserrat"
                android:paddingStart="10dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp"
                android:text="@string/overview1"
                android:textAlignment="textStart"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/casesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/overviewText1"
                android:layout_marginTop="5dp"
                android:background="@color/colorPrimaryDark"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:fontFamily="@font/montserrat_bold"
                    android:text="Cases Summary (DOH Data Drop)"
                    android:textAlignment="center"
                    android:textColor="@color/colorPrimary"
                    android:textSize="12sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/casesSummary"
                    android:layout_width="match_parent"
                    android:layout_height="200dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="500dp"
                android:layout_below="@id/casesContainer"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:layout_marginTop="5dp"
                android:background="@color/colorPrimaryDark"
                android:orientation="vertical"
                android:padding="10dp">

            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
</ScrollView>